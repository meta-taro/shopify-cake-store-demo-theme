{
  "name": "shopify-cake-store-demo-theme",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling for the Sweet Atelier Demo Shopify theme (screenshot capture, Lighthouse audit, etc.)",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "lint": "shopify theme check",
    "prepare": "lefthook install",
    "screenshot:baseline": "node scripts/capture-screenshots.mjs",
    "screenshot:phase7": "node scripts/capture-phase-7.mjs",
    "screenshot:phase9": "node scripts/capture-phase-9.mjs",
    "lighthouse:capture": "node scripts/lighthouse-capture.mjs"
  },
  "devDependencies": {
    "lefthook": "^1.10.0",
    "lighthouse": "^13.3.0",
    "playwright": "^1.49.0"
  }
}
