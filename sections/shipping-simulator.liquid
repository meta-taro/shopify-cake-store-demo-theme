{%- comment -%}
  送料シミュレーター（Phase 9c）
  - 都道府県を選ぶと送料区分に応じた目安を表示。任意の注文金額で送料無料判定も行う。
  - ロジックは assets/shipping-simulator.js（localStorage キー sweet-atelier:shipping-pref）。
  - 料金・しきい値はセクション設定から data-* 属性で渡すため、コードを触らず調整できる。
  - フロントエンドのみ（Shopify 設定・アプリ不要）。
{%- endcomment -%}

{{ 'component-shipping-simulator.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="shipping-simulator-wrapper color-{{ section.settings.color_scheme }} gradient">
  <div class="shipping-simulator page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="shipping-simulator__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <div class="shipping-simulator__subtext rte">{{ section.settings.subtext }}</div>
    {%- endif -%}

    <shipping-simulator
      class="shipping-simulator__card"
      data-fee-honshu="{{ section.settings.fee_honshu }}"
      data-fee-kotetsu="{{ section.settings.fee_kotetsu }}"
      data-fee-okinawa="{{ section.settings.fee_okinawa }}"
      data-free-threshold="{{ section.settings.free_threshold }}"
    >
      <div class="shipping-simulator__fields">
        <div class="shipping-simulator__field">
          <label class="form__label" for="ShippingSimPref-{{ section.id }}">お届け先（都道府県）</label>
          <select id="ShippingSimPref-{{ section.id }}" class="select__select" data-pref-select>
            <option value="">お届け先の都道府県を選択</option>
          </select>
        </div>
        <div class="shipping-simulator__field">
          <label class="form__label" for="ShippingSimAmount-{{ section.id }}">ご注文金額（任意・税込）</label>
          <input
            id="ShippingSimAmount-{{ section.id }}"
            class="field__input"
            type="number"
            inputmode="numeric"
            min="0"
            step="100"
            placeholder="例: 8000"
            data-amount-input
          >
        </div>
      </div>
      <div class="shipping-simulator__result" role="status" aria-live="polite" data-result>
        <p class="shipping-simulator__hint">都道府県を選ぶと、お届け先の送料の目安を表示します。</p>
      </div>
    </shipping-simulator>
  </div>
</div>

<script src="{{ 'shipping-simulator.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "送料シミュレーター",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "送料シミュレーター"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "見出しサイズ",
      "options": [
        { "value": "h2", "label": "標準" },
        { "value": "h1", "label": "大" },
        { "value": "h0", "label": "特大" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "説明文",
      "default": "<p>お届け先の都道府県を選ぶと、送料の目安を確認できます。</p>"
    },
    {
      "type": "header",
      "content": "送料の設定"
    },
    {
      "type": "number",
      "id": "fee_honshu",
      "label": "本州の送料（円）",
      "default": 980
    },
    {
      "type": "number",
      "id": "fee_kotetsu",
      "label": "北海道・四国・九州の送料（円）",
      "default": 1280
    },
    {
      "type": "number",
      "id": "fee_okinawa",
      "label": "沖縄の送料（円）",
      "default": 1800
    },
    {
      "type": "number",
      "id": "free_threshold",
      "label": "送料無料になる注文金額（円・沖縄を除く）",
      "default": 10000
    },
    {
      "type": "header",
      "content": "色と余白"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "カラースキーム",
      "default": "background-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "上の余白",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "下の余白",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "送料シミュレーター"
    }
  ],
  "enabled_on": {
    "templates": ["page", "index", "cart"]
  }
}
{% endschema %}
