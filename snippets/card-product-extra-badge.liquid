{% comment %}
  Renders one badge (人気 / 季節限定 / 新商品 / アレルゲン情報あり) inside card__badge.
  Shown only when the product isn't sold out and isn't on sale.

  Priority (first match wins): popular > seasonal (live or pre) > new > has allergen metafield
  (allergen = the Shopify standard "アレルゲン情報" category metafield, falling back to custom.allergens)

  For seasonal products with custom.sale_end (date) set, the label is expanded
  to "季節限定 ・ 残り N 日" while the sale is live; once the period has ended,
  the seasonal badge is hidden and the next-priority badge takes over.

  Accepts:
  - card_product: {Object}
  - badge_id: {String} unique id (matches aria-labelledby in card heading link)
{% endcomment %}

{%- liquid
  assign seasonal_active = false
  assign seasonal_label = '季節限定'
  if card_product.tags contains 'seasonal'
    assign sale_end = card_product.metafields.custom.sale_end.value
    if sale_end == blank
      assign seasonal_active = true
    else
      assign now_ts = 'now' | date: '%s' | plus: 0
      assign end_ts = sale_end | date: '%s' | plus: 0
      assign sale_start = card_product.metafields.custom.sale_start.value
      if sale_start != blank
        assign start_ts = sale_start | date: '%s' | plus: 0
      else
        assign start_ts = 0
      endif
      if start_ts > 0 and now_ts < start_ts
        assign seasonal_active = true
      elsif now_ts > end_ts
        assign seasonal_active = false
      else
        assign seasonal_active = true
        assign diff_to_end = end_ts | minus: now_ts | plus: 86399
        assign days_left = diff_to_end | divided_by: 86400
        if days_left < 0
          assign days_left = 0
        endif
        if days_left == 0
          assign seasonal_label = '季節限定 ・ 本日最終日'
        elsif days_left == 1
          assign seasonal_label = '季節限定 ・ 残り 1 日'
        else
          assign seasonal_label = '季節限定 ・ 残り ' | append: days_left | append: ' 日'
        endif
      endif
    endif
  endif

  assign extra_label = ''
  assign extra_class = ''
  if card_product.tags contains 'popular'
    assign extra_label = '人気'
    assign extra_class = 'badge--popular'
  elsif seasonal_active
    assign extra_label = seasonal_label
    assign extra_class = 'badge--seasonal'
  elsif card_product.tags contains 'new'
    assign extra_label = '新商品'
    assign extra_class = 'badge--new'
  else
    assign allergen_meta = card_product.metafields.shopify["allergen-information"].value | default: card_product.metafields.custom.allergens.value
    if allergen_meta != blank
      assign extra_label = 'アレルゲン情報あり'
      assign extra_class = 'badge--allergen'
    endif
  endif
-%}

{%- if extra_label != blank -%}
  <span
    id="{{ badge_id }}"
    class="badge badge--bottom-left {{ extra_class }}"
  >
    {{- extra_label -}}
  </span>
{%- endif -%}
