{% comment %}
  Renders Sweet Atelier gift options as line item properties.
  Skipped for gift card products (they have their own recipient form).

  Accepts:
  - section_id: {String} unique section id for input ids and JS scoping
  - product: {Object} for gift_card? check
{% endcomment %}

{%- unless product.gift_card? -%}
  {{ 'component-gift-options.css' | asset_url | stylesheet_tag }}

  <fieldset
    class="gift-options"
    data-gift-options="{{ section_id }}"
  >
    <legend class="gift-options__legend">
      ギフトオプション
      <span class="gift-options__optional">（任意）</span>
    </legend>

    <div class="gift-options__field gift-options__field--checkbox">
      <input
        type="checkbox"
        id="GiftNoshi-{{ section_id }}"
        name="properties[熨斗]"
        value="希望する"
        class="gift-options__checkbox-input"
        data-gift-toggle="noshi"
      >
      <label for="GiftNoshi-{{ section_id }}" class="gift-options__checkbox-label">
        熨斗をお付けする
      </label>
    </div>

    <div
      class="gift-options__nested gift-options__nested--noshi"
      data-gift-nested="noshi"
      hidden
    >
      <div class="gift-options__field">
        <label class="form__label" for="GiftNoshiPurpose-{{ section_id }}">熨斗の用途</label>
        <div class="select">
          <select
            id="GiftNoshiPurpose-{{ section_id }}"
            name="properties[熨斗の用途]"
            class="select__select"
            disabled
            data-noshi-purpose-input
          >
            <option value="">選択してください</option>
            <option value="御祝">御祝</option>
            <option value="内祝">内祝</option>
            <option value="お誕生日">お誕生日</option>
            <option value="お礼">お礼</option>
            <option value="その他">その他</option>
          </select>
          <span class="svg-wrapper">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </div>
      </div>

      <div class="gift-options__field">
        <div class="field">
          <input
            type="text"
            id="GiftNoshiName-{{ section_id }}"
            name="properties[熨斗の名入れ]"
            class="field__input"
            placeholder=" "
            maxlength="20"
            disabled
            data-noshi-name-input
          >
          <label for="GiftNoshiName-{{ section_id }}" class="field__label">
            名入れ（任意・20字まで）
          </label>
        </div>
      </div>

      <div
        class="gift-options__noshi-preview"
        data-noshi-preview
        hidden
      >
        <p class="gift-options__noshi-caption">プレビュー（イメージ）</p>
        <div class="gift-options__noshi-paper" aria-hidden="true">
          <div class="gift-options__noshi-purpose" data-noshi-purpose-text></div>
          <div class="gift-options__noshi-mizuhiki">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 240 32"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M0 8 Q70 8 110 16" fill="none" stroke="#c8516b" stroke-width="2"/>
              <path d="M0 13 Q70 13 110 16" fill="none" stroke="#c8516b" stroke-width="2"/>
              <path d="M0 19 Q70 19 110 16" fill="none" stroke="#f5f5f5" stroke-width="2"/>
              <path d="M0 24 Q70 24 110 16" fill="none" stroke="#f5f5f5" stroke-width="2"/>
              <path d="M240 8 Q170 8 130 16" fill="none" stroke="#c8516b" stroke-width="2"/>
              <path d="M240 13 Q170 13 130 16" fill="none" stroke="#c8516b" stroke-width="2"/>
              <path d="M240 19 Q170 19 130 16" fill="none" stroke="#f5f5f5" stroke-width="2"/>
              <path d="M240 24 Q170 24 130 16" fill="none" stroke="#f5f5f5" stroke-width="2"/>
              <ellipse cx="120" cy="16" rx="14" ry="5.5" fill="#c8516b" stroke="#8a3450" stroke-width="0.4"/>
              <ellipse cx="120" cy="16" rx="8" ry="2.6" fill="#f5f5f5"/>
            </svg>
          </div>
          <div class="gift-options__noshi-name" data-noshi-name-text></div>
        </div>
      </div>
    </div>

    <div class="gift-options__field">
      <label class="form__label" for="GiftMessage-{{ section_id }}">
        メッセージカード（任意・100字まで）
      </label>
      <textarea
        id="GiftMessage-{{ section_id }}"
        name="properties[メッセージカード]"
        class="gift-options__textarea text-area"
        maxlength="100"
        rows="3"
        placeholder="お祝いメッセージなどをご記入ください"
        data-gift-counter-input
      ></textarea>
      <p
        class="gift-options__counter"
        data-gift-counter
        aria-live="polite"
      >
        <span data-gift-counter-current>0</span><span aria-hidden="true"> / </span><span class="visually-hidden"> / </span><span>100</span> 字
      </p>
    </div>

    <div class="gift-options__field gift-options__field--checkbox">
      <input
        type="checkbox"
        id="GiftWrapping-{{ section_id }}"
        class="gift-options__checkbox-input"
        data-gift-toggle="wrapping"
      >
      <label for="GiftWrapping-{{ section_id }}" class="gift-options__checkbox-label">
        ギフトラッピングを付ける（無料）
      </label>
    </div>

    <div
      class="gift-options__nested gift-options__nested--wrapping"
      data-gift-nested="wrapping"
      hidden
    >
      <fieldset class="gift-options__radio-group">
        <legend class="gift-options__radio-legend">ラッピングスタイルを選択</legend>

        <label class="gift-options__radio-card">
          <input
            type="radio"
            name="properties[ギフトラッピング]"
            value="シンプル"
            class="gift-options__radio-input"
            checked
            disabled
          >
          <span class="gift-options__radio-frame">
            <img
              src="{{ 'wrapping-simple.svg' | asset_url }}"
              alt=""
              class="gift-options__radio-thumb"
              width="64"
              height="64"
              loading="lazy"
            >
          </span>
          <span class="gift-options__radio-label">シンプル</span>
          <span class="gift-options__radio-sub">無地の包装紙でやさしく包みます</span>
        </label>

        <label class="gift-options__radio-card">
          <input
            type="radio"
            name="properties[ギフトラッピング]"
            value="リボン付き"
            class="gift-options__radio-input"
            disabled
          >
          <span class="gift-options__radio-frame">
            <img
              src="{{ 'wrapping-ribbon.svg' | asset_url }}"
              alt=""
              class="gift-options__radio-thumb"
              width="64"
              height="64"
              loading="lazy"
            >
          </span>
          <span class="gift-options__radio-label">リボン付き</span>
          <span class="gift-options__radio-sub">アクセントにリボンを結びます</span>
        </label>

        <label class="gift-options__radio-card">
          <input
            type="radio"
            name="properties[ギフトラッピング]"
            value="箱入り"
            class="gift-options__radio-input"
            disabled
          >
          <span class="gift-options__radio-frame">
            <img
              src="{{ 'wrapping-box.svg' | asset_url }}"
              alt=""
              class="gift-options__radio-thumb"
              width="64"
              height="64"
              loading="lazy"
            >
          </span>
          <span class="gift-options__radio-label">箱入り</span>
          <span class="gift-options__radio-sub">専用ボックスでしっかりお届け</span>
        </label>
      </fieldset>
    </div>
  </fieldset>

  <script>
    (function () {
      var root = document.querySelector('[data-gift-options="{{ section_id }}"]');
      if (!root) return;
      var toggles = root.querySelectorAll('[data-gift-toggle]');
      toggles.forEach(function (toggle) {
        var key = toggle.getAttribute('data-gift-toggle');
        var nested = root.querySelector('[data-gift-nested="' + key + '"]');
        if (!nested) return;
        var fields = nested.querySelectorAll('input, select, textarea');

        function update() {
          var on = toggle.checked;
          nested.hidden = !on;
          fields.forEach(function (f) {
            f.disabled = !on;
            if (on) return;
            if (f.tagName === 'SELECT') {
              f.selectedIndex = 0;
              f.dispatchEvent(new Event('change', { bubbles: true }));
            } else if (f.tagName === 'TEXTAREA' || f.type === 'text') {
              f.value = '';
              f.dispatchEvent(new Event('input', { bubbles: true }));
            }
          });
        }

        toggle.addEventListener('change', update);
        update();
      });

      var noshiPreview = root.querySelector('[data-noshi-preview]');
      if (noshiPreview) {
        var purposeSelect = root.querySelector('[data-noshi-purpose-input]');
        var nameInput = root.querySelector('[data-noshi-name-input]');
        var purposeText = noshiPreview.querySelector('[data-noshi-purpose-text]');
        var nameText = noshiPreview.querySelector('[data-noshi-name-text]');

        function updateNoshiPreview() {
          var purpose = purposeSelect ? purposeSelect.value : '';
          var name = nameInput ? nameInput.value : '';
          if (purposeText) purposeText.textContent = purpose;
          if (nameText) nameText.textContent = name;
          noshiPreview.hidden = !(purpose || name);
        }

        if (purposeSelect) purposeSelect.addEventListener('change', updateNoshiPreview);
        if (nameInput) nameInput.addEventListener('input', updateNoshiPreview);
        updateNoshiPreview();
      }

      var counterInputs = root.querySelectorAll('[data-gift-counter-input]');
      counterInputs.forEach(function (input) {
        var counter = input.parentElement && input.parentElement.querySelector('[data-gift-counter]');
        if (!counter) return;
        var currentEl = counter.querySelector('[data-gift-counter-current]');
        if (!currentEl) return;
        var max = parseInt(input.getAttribute('maxlength'), 10) || 0;
        var threshold = max ? Math.floor(max * 0.9) : 0;

        function updateCounter() {
          var len = input.value.length;
          currentEl.textContent = len;
          counter.classList.toggle('gift-options__counter--warning', max > 0 && len >= threshold && len < max);
          counter.classList.toggle('gift-options__counter--limit', max > 0 && len >= max);
        }

        input.addEventListener('input', updateCounter);
        updateCounter();
      });
    })();
  </script>
{%- endunless -%}
